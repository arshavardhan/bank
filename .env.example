# =========================================================
# AI Financial Statement Analysis Agent - Environment Configuration
# =========================================================

# Application
APP_NAME="AI Financial Statement Analysis Agent"
APP_VERSION="1.0.0"
DEBUG=false

# LLM Provider: "gemini", "openai", or "mock"
LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# OpenAI Configuration (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Database Configuration (SQLite by default, or PostgreSQL for production)
DATABASE_URL=sqlite:///./financial_agent.db
# For PostgreSQL via docker-compose:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_db

# Qdrant Vector Store Configuration
# Use ':memory:' for in-memory embedded vector store, or URL for containerized Qdrant
QDRANT_LOCATION=:memory:
# For remote Qdrant:
# QDRANT_LOCATION=http://localhost:6333
QDRANT_COLLECTION_NAME=statement_documents

# Langfuse Observability Configuration
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# File Upload & Security Limits
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./uploads
